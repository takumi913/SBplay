<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The instrument cluster reads album art through a Uri, and on this Android version the app's
         external files directory is the straightforward way to hand a file to another process
         (DiagnosticExportStore already exports reports the same way). Install-time granted here;
         harmless elsewhere because the cluster API does not exist there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="com.shilapi.xcertplay.SBplayApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_carplay"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xcertplay">

        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            tools:replace="android:enabled" />

        <!-- Opens DiPlay when the selected iPhone reconnects over Bluetooth (upstream fe1a59d).
             System broadcasts still reach a non-exported receiver; only other apps cannot. -->
        <receiver
            android:name="com.shilapi.xcertplay.PhoneBluetoothReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
